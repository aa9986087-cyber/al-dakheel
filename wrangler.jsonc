// Cloudflare Workers + Durable Objects (free plan). One Worker serves the game files and the real-time rooms.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-dakheel",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*", "/api/*", "/mafia/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      // Rooms of the Mafia game (its pages are on GitHub Pages; see the mafia repository)
      { "name": "MAFIA", "class_name": "MafiaGame" }
    ]
  },
  // SQLite-backed Durable Objects are the ones available on the free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["MafiaGame"] }
  ],
  "observability": { "enabled": true }
}
